repeat task.wait() until _G.WindUI and _G.Functions

local WindUI, Tabs, Players, TextChatService = _G.WindUI, _G.Tabs, game.Players, game.TextChatService
local lp = Players.LocalPlayer
local modListen, cmdNotify, logChat = true, false, false
local nc
local pendingNames = {}
local containerConn
local hookedContainer

local function fetchpush()
    local ok, env = pcall(getrenv)
    if ok and env and type(env._G) == 'table' then
        local p = env._G.PushNotification
        if type(p) == 'function' then return p end
    end
    return nil
end

local function coldfetch()
    local list = getnilinstances()
    if type(list) ~= 'table' then return end
    for _, obj in ipairs(list) do
        if obj:IsA('BindableFunction') then
            local ok, cb = pcall(getcallbackvalue, obj, 'OnInvoke')
            if ok and type(cb) == 'function' then
                nc = cb
                return
            end
        end
    end
end

task.spawn(function()
    for _ = 1, 30 do
        if fetchpush() then return end
        coldfetch()
        if nc then return end
        task.wait(0.5)
    end
end)

local function notify(color, text, duration)
    local push = fetchpush()
    if not push then
        if not nc then coldfetch() end
        push = nc
    end
    if not push then return end
    pcall(push, color, text, duration or 5, nil, nil, nil)
end

local function getnotifcontainer()
    local pg = lp:FindFirstChild('PlayerGui')
    if not pg then return nil end
    local gg = pg:FindFirstChild('GameGui')
    if not gg then return nil end
    local bl = gg:FindFirstChild('BottomLeft')
    if not bl then return nil end
    return bl:FindFirstChild('Notifications')
end

local function triggerclickhint(playerName)
    if setclipboard then
        setclipboard(':to ' .. playerName)
    end
    notify('Yellow', [[so i kinda dont know how erx detects chat commands so just open chat and do ctrl v and enter sorry]], 20)
end

local function attachcontainer()
    if containerConn then
        pcall(function() containerConn:Disconnect() end)
        containerConn = nil
    end
    hookedContainer = nil

    local container
    for _ = 1, 60 do
        container = getnotifcontainer()
        if container then break end
        task.wait(0.5)
    end
    if not container then return end

    hookedContainer = container
    containerConn = container.ChildAdded:Connect(function(child)
        if not next(pendingNames) then return end

        local function match()
            for _, d in ipairs(child:GetDescendants()) do
                if d:IsA('TextLabel') and d.Text and d.Text ~= '' then
                    for name in pairs(pendingNames) do
                        if d.Text:find(name, 1, true) then
                            pendingNames[name] = nil
                            local btn = child:IsA('GuiButton') and child or child:FindFirstChildWhichIsA('TextButton', true)
                            if btn and btn.MouseButton1Down then
                                btn.MouseButton1Down:Connect(function()
                                    triggerclickhint(name)
                                end)
                            end
                            return true
                        end
                    end
                end
            end
            return false
        end

        if not match() then
            local conn
            conn = child.DescendantAdded:Connect(function()
                if match() and conn then
                    conn:Disconnect()
                end
            end)
        end
    end)
end

task.spawn(attachcontainer)

task.spawn(function()
    while task.wait(3) do
        if not hookedContainer or not hookedContainer:IsDescendantOf(lp.PlayerGui) then
            task.spawn(attachcontainer)
        end
    end
end)

local function triggerbuiltinnotify(playerName)
    local push = fetchpush()
    if not push then
        if not nc then coldfetch() end
        push = nc
    end
    if not push then return end

    pendingNames[playerName] = true

    pcall(push, 'Yellow', playerName .. ' has requested assistance! Click to go assist them!', 15, nil, {
        name = 'ModHelpTeleport',
        data = {PlayerName = playerName},
    })

    task.delay(20, function()
        pendingNames[playerName] = nil
    end)
end

local viewingMe = {}

local function isviewingme(arg)
    if arg == '' then return false end

    local a = arg:lower()
    local myName = lp.Name:lower()
    local myDisplay = (lp.DisplayName or ''):lower()

    if myName ~= '' and myName:sub(1, #a) == a then return true end
    if myDisplay ~= '' and myDisplay:sub(1, #a) == a then return true end
    if #a <= #myName and myName:find(a, 1, true) == 1 then return true end
    if myDisplay ~= '' and #a <= #myDisplay and myDisplay:find(a, 1, true) == 1 then return true end

    return false
end

local function handlmsg(name, text)
    local lower = text:lower()
    local firstChar = text:sub(1, 1)
    local isCmd = firstChar == ':' or firstChar == '!' or firstChar == ';'
    local cmdName, cmdArgs = '', ''

    if isCmd then
        local rest = lower:sub(2):gsub('^%s+', '')
        cmdName = rest:match('^(%a+)') or ''

        if cmdName ~= '' then
            local afterName = rest:sub(#cmdName + 1)
            if afterName ~= '' and afterName:sub(1, 1):match('%s') == nil then
                cmdName = ''
            else
                cmdArgs = afterName:gsub('^%s+', ''):gsub('%s+$', '')
            end
        end
    end

    local isCall = cmdName == 'mod' or cmdName == 'help'

    if logChat and not isCmd then
        notify('Grey', name .. ': ' .. text, 10)
    end

    if modListen and isCall then
        triggerbuiltinnotify(name)
    end

    local suppressGeneric = false
    if cmdName == 'view' then
        if isviewingme(cmdArgs) then
            suppressGeneric = true
            if not viewingMe[name] then
                viewingMe[name] = true
                notify('Red', name .. ' is viewing you!', 8)
            end
        elseif viewingMe[name] then
            viewingMe[name] = nil
            notify('Red', name .. ' stopped viewing you.', 8)
        end
    end

    if cmdNotify and isCmd and not isCall and cmdName ~= '' and not suppressGeneric then
        notify('Red', name .. ' used: ' .. text, 8)
    end
end

if TextChatService.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
    TextChatService.MessageReceived:Connect(function(msg)
        if not msg.TextSource then return end
        if msg.Status == Enum.TextChatMessageStatus.InvalidTextChannelPermissions then return end
        local p = Players:GetPlayerByUserId(msg.TextSource.UserId)
        if p then handlmsg(p.Name, msg.Text) end
    end)
else
    local function hook(p)
        p.Chatted:Connect(function(m)
            handlmsg(p.Name, m)
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do
        hook(p)
    end
    Players.PlayerAdded:Connect(hook)
end

local function onrespawn()
    nc = nil
    pendingNames = {}
    task.spawn(attachcontainer)
    task.spawn(function()
        for _ = 1, 60 do
            if fetchpush() then return end
            coldfetch()
            if nc then return end
            task.wait(0.5)
        end
    end)
end

lp.CharacterAdded:Connect(function()
    task.wait(1.5)
    onrespawn()
end)

