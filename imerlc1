    ":view",
}

local function onlocalcommand(text)
    local cmd = parsecommandname(text)
    if not cmd then return end

    local rest = text:sub(2):gsub("^%s+", "")
    local name = rest:match("^(%a+)") or ""
    local argstr = rest:sub(#name + 1):gsub("^%s+", ""):gsub("%s+$", "")

    if cmd == ":killlogs" or cmd == ":kl" then
        notify("Red", "sorry this doesnt work yet", 5)
    elseif cmd == ":commands" or cmd == ":cmds" then
        openadminlist("CommandsList", "Admin Commands", commands, function(c) return c end)
    elseif cmd == ":logs" then
        openlogswith(argstr)
    elseif cmd == ":log" then
        local playerarg, reason = argstr:match("^(%S+)%s+(.+)$")
        if not playerarg then
            openlogswith("")
            return
        end
        if not reason or reason == "" then
            openlogswith(playerarg)
            return
        end
        local p = resolveplayer(playerarg)
        local display = p and p.Name or playerarg
        notify("Green", "Attempted to log " .. display .. " for " .. reason .. ".", 5)
        pcall(function()
            local fe = replicatedstorage:FindFirstChild("FE")
            if not fe then return end
            for _, rn in ipairs({ "LogCommand", "Log", "AdminLog", "AddLog", "LogAction" }) do
                local r = fe:FindFirstChild(rn)
                if r and r:IsA("RemoteEvent") then
                    pcall(function() r:FireServer("log", display, reason) end)
                    pcall(function() r:FireServer(display, reason) end)
                    pcall(function() r:FireServer(lp.Name, display, reason) end)
                end
            end
        end)
    end
end

local lastseen = {}
local function handlemessage(text)
    if not enabled then return end
    local now = tick()
    local prev = lastseen[text]
    if prev and (now - prev) < 1.5 then return end
    lastseen[text] = now
    onlocalcommand(text)
end

pcall(function()
    if textchatservice.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
        local c = textchatservice.MessageReceived:Connect(function(msg)
            if msg.TextSource and msg.TextSource.UserId == lp.UserId then
                handlemessage(msg.Text)
            end
        end)
        table.insert(_G._adminCommandsLoaded, c)
    end
    local c2 = lp.Chatted:Connect(handlemessage)
    table.insert(_G._adminCommandsLoaded, c2)
end)

