_G._adminLogsCache = _G._adminLogsCache or {}
local notifycallback = nil
local notifyready = false

local function fetchnotifycallback()
    local list
    local ok = pcall(function() list = getnilinstances() end)
    if not ok or type(list) ~= "table" then return false end
    local event
    for _, obj in ipairs(list) do
        if obj.Name == "Function" or obj.Name == "BindableFunction" then
            local s, cb = pcall(function() return getcallbackvalue(obj, "OnInvoke") end)
            if s and type(cb) == "function" then event = cb; break end
        end
    end
    if not event then
        for _, obj in ipairs(list) do
            if obj:IsA("BindableFunction") then
                local s, cb = pcall(function() return getcallbackvalue(obj, "OnInvoke") end)
                if s and type(cb) == "function" then event = cb; break end
            end
        end
    end
    if event then
        notifycallback = event
        notifyready = true
        return true
    end
    return false
end

task.spawn(function()
    task.wait(2 + math.random() * 3)
    pcall(fetchnotifycallback)
end)

local function notify(color, text, duration)
    if notifyready and notifycallback then
        pcall(function()
            notifycallback(color, text, duration or 5, nil, nil, nil)
        end)
    end
end

local function parsecommand(text)
    local fc = text:sub(1, 1)
    if fc ~= ":" and fc ~= "!" and fc ~= ";" then return nil end
    local rest = text:sub(2):gsub("^%s+", "")
    local name = rest:match("^(%a+)") or ""
    if name == "" then return nil end
    local after = rest:sub(#name + 1)
    if after ~= "" and after:sub(1, 1):match("%s") == nil then return nil end
    return name:lower()
end

local function addadminlog(actor, message)
    table.insert(_G._adminLogsCache, 1, { actor, message, os.time() })
end

pcall(function()
    if textchatservice.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
        textchatservice.MessageReceived:Connect(function(msg)
            if msg.TextSource then
                local p = players:GetPlayerByUserId(msg.TextSource.UserId)
                if p and parsecommand(msg.Text) then
                    addadminlog(p.Name, msg.Text)
                end
            end
        end)
    else
        local function hook(p)
            p.Chatted:Connect(function(m)
                if parsecommand(m) then addadminlog(p.Name, m) end
            end)
        end
        for _, p in ipairs(players:GetPlayers()) do hook(p) end
        players.PlayerAdded:Connect(hook)
    end
end)

