local notifycallback = nil
local notifyready = false
local currentlistname = nil
local searchwired = false

local function fetchnotifycallback()
    local list
    local ok = pcall(function() list = getnilinstances() end)
    if not ok or type(list) ~= "table" then return false end
    local event
    for _, obj in ipairs(list) do
        if obj.Name == "Function" or obj.Name == "BindableFunction" then
            local s, cb = pcall(function() return getcallbackvalue(obj, "OnInvoke") end)
            if s and type(cb) == "function" then event = cb; break end
        end
    end
    if not event then
        for _, obj in ipairs(list) do
            if obj:IsA("BindableFunction") then
                local s, cb = pcall(function() return getcallbackvalue(obj, "OnInvoke") end)
                if s and type(cb) == "function" then event = cb; break end
            end
        end
    end
    if event then
        notifycallback = event
        notifyready = true
        return true
    end
    return false
end

task.spawn(function()
    task.wait(2 + math.random() * 3)
    pcall(fetchnotifycallback)
end)

local function notify(color, text, duration)
    if notifyready and notifycallback then
        pcall(function()
            notifycallback(color, text, duration or 5, nil, nil, nil)
        end)
    end
end

local function parsecommandname(text)
    local fc = text:sub(1, 1)
    if fc ~= ":" and fc ~= "!" and fc ~= ";" then return nil end
    local rest = text:sub(2):gsub("^%s+", "")
    local name = rest:match("^(%a+)") or ""
    if name == "" then return nil end
    local after = rest:sub(#name + 1)
    if after ~= "" and after:sub(1, 1):match("%s") == nil then return nil end
    return ":" .. name:lower()
end

local function resolveplayer(prefix)
    if not prefix or prefix == "" then return nil end
    local pfx = prefix:lower()
    for _, p in ipairs(players:GetPlayers()) do
        if p.Name:lower():sub(1, #pfx) == pfx then return p end
        local dn = p.DisplayName or ""
        if dn:lower():sub(1, #pfx) == pfx then return p end
    end
    return nil
end

function getadmin()
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return nil, nil end
    local gm = pg:FindFirstChild("GameMenus") or pg:WaitForChild("GameMenus", 10)
    if not gm then return nil, nil end
    local admin = gm:FindFirstChild("Admin") or gm:WaitForChild("Admin", 5)
    return gm, admin
end

local function filterlist(admin, needle)
    for _, frame in ipairs(admin:GetChildren()) do
        if frame:IsA("ScrollingFrame") and frame.Visible then
            if needle == "" then
                for _, lbl in ipairs(frame:GetChildren()) do
                    if lbl:IsA("TextLabel") then lbl.Visible = true end
                end
            else
                local low = needle:lower()
                for _, lbl in ipairs(frame:GetChildren()) do
                    if lbl:IsA("TextLabel") then
                        if string.find(lbl.Text:lower(), low, 1, true) then
                            lbl.Visible = true
                        else
                            lbl.Visible = false
                        end
                    end
                end
            end
            return
        end
    end
end

local function wiresearch(admin)
    if searchwired then return end
    local search = admin:FindFirstChild("Search")
    if not search or not search:IsA("TextBox") then return end
    searchwired = true
    search:GetPropertyChangedSignal("Text"):Connect(function()
        filterlist(admin, search.Text or "")
    end)
    search.FocusLost:Connect(function()
        filterlist(admin, search.Text or "")
    end)
end

local function wirehover(clone, admin)
    local hovertext = admin:FindFirstChild("HoverText")
    if not hovertext then return end
    clone.MouseEnter:Connect(function()
        hovertext.Text = clone.Text
        hovertext.Visible = true
    end)
    clone.MouseLeave:Connect(function()
        hovertext.Visible = false
    end)
end

local function renderlist(listname, titletext, items, labelfactory)
    local gm, admin = getadmin()
    if not gm or not admin then return end
    local adminls = admin:FindFirstChild("Admin LS")
    if not adminls then return end
    local template = adminls:FindFirstChild("ListItem") or adminls:FindFirstChild("CommandListItem")
    if not template then return end
    local list = admin:FindFirstChild(listname)
    if not list then return end

    for _, child in ipairs(admin:GetChildren()) do
        if child:IsA("ScrollingFrame") then child.Visible = false end
    end
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    local titlebar = admin:FindFirstChild("TitleBar")
    if titlebar and titlebar:FindFirstChild("Title") then
        titlebar.Title.Text = titletext
    end

    local search = admin:FindFirstChild("Search")
    if search then
        search.Visible = (listname == "LogsList")
        if search:IsA("TextBox") then search.Text = "" end
    end

    for i, item in ipairs(items) do
        local clone = template:Clone()
        clone.Name = "Item" .. i
        clone.Text = labelfactory(item)
        clone.LayoutOrder = i
        clone.Parent = list
        wirehover(clone, admin)
    end

    list.Visible = true

    local layout = list:FindFirstChildOfClass("UIListLayout")
    if layout then
        list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
    end

    wiresearch(admin)
    currentlistname = listname
end

local function openadminlist(listname, titletext, items, labelfactory)
    renderlist(listname, titletext, items, labelfactory)
    local gm, admin = getadmin()
    if not admin then return end
    gm.Enabled = true
    admin.Position = UDim2.new(0.5, 0, 1.5, 0)
    admin.Visible = true
    _G.InMenu = admin
    _G.InMenuType = "Small"
    tween:Create(
        admin,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.5, 0, 0.5, 0) }
    ):Play()
end

local function loglabel(e)
    return tostring(e[1] or "?") .. " - " .. tostring(e[2] or "")
end

local function openlogswith(filter)
    local items = _G._adminLogsCache
    if filter and filter ~= "" then
        local pfx = filter:lower()
        local filtered = {}
        for _, e in ipairs(items) do
            local actor = tostring(e[1] or ""):lower()
            if actor:sub(1, #pfx) == pfx then
                table.insert(filtered, e)
            end
        end
        items = filtered
        if #items == 0 then
            items = { { "no matches", "no logs matching '" .. filter .. "'" } }
        end
    elseif #items == 0 then
        items = { { "no commands yet", "waiting for a command" } }
    end
    openadminlist("LogsList", "Admin Logs", items, loglabel)
end

local function onentryadded()
    if currentlistname == "LogsList" then
        task.spawn(function()
            pcall(function()
                local items = _G._adminLogsCache
                if #items == 0 then
                    items = { { "no commands yet", "waiting for a command" } }
                end
                local gm, admin = getadmin()
                if not admin then return end
                local list = admin:FindFirstChild("LogsList")
                if not list or not list.Visible then return end
                local adminls = admin:FindFirstChild("Admin LS")
                local template = adminls and (adminls:FindFirstChild("ListItem") or adminls:FindFirstChild("CommandListItem"))
                if not template then return end
                for _, child in ipairs(list:GetChildren()) do
                    if child:IsA("TextLabel") then child:Destroy() end
                end
                for i, item in ipairs(items) do
                    local clone = template:Clone()
                    clone.Name = "Item" .. i
                    clone.Text = loglabel(item)
                    clone.LayoutOrder = i
                    clone.Parent = list
                    wirehover(clone, admin)
                end
                local layout = list:FindFirstChildOfClass("UIListLayout")
                if layout then
                    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
                end
                local search = admin:FindFirstChild("Search")
                if search and search:IsA("TextBox") and search.Text ~= "" then
                    filterlist(admin, search.Text)
                end
            end)
        end)
    end
end

local function addadminlog(actor, message)
    if type(actor) ~= "string" or actor == "" then actor = "Remote Server" end
    table.insert(_G._adminLogsCache, 1, { actor, message })
    onentryadded()
end

pcall(function()
    local conn
    local seen = {}
    local function onreceived(actor, message)
        local key = actor .. "|" .. message
        local now = tick()
        if seen[key] and (now - seen[key]) < 2 then return end
        seen[key] = now
        if parsecommandname(message) then
            addadminlog(actor, message)
        end
    end

    if textchatservice.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
        conn = textchatservice.MessageReceived:Connect(function(msg)
            local text = msg.Text or ""
            if not parsecommandname(text) then return end
            local p = msg.TextSource and players:GetPlayerByUserId(msg.TextSource.UserId)
            if p then
                onreceived(p.Name, text)
            else
                onreceived("Remote Server", text)
            end
        end)
    else
        local function hook(p)
            local c = p.Chatted:Connect(function(m)
                if parsecommandname(m) then addadminlog(p.Name, m) end
            end)
            table.insert(_G._adminCommandsLoaded, c)
        end
        for _, p in ipairs(players:GetPlayers()) do hook(p) end
        local c = players.PlayerAdded:Connect(hook)
        table.insert(_G._adminCommandsLoaded, c)
    end
    if conn then table.insert(_G._adminCommandsLoaded, conn) end
end)

local commands = {
    ":track [Player]",
    ":load",
