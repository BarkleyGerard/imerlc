local function getadmin()
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return nil, nil end
    local gm = pg:FindFirstChild("GameMenus") or pg:WaitForChild("GameMenus", 10)
    if not gm then return nil, nil end
    local admin = gm:FindFirstChild("Admin") or gm:WaitForChild("Admin", 5)
    return gm, admin
end

local function renderlist(listname, titletext, items, labelfactory)
    local gm, admin = getadmin()
    if not gm or not admin then return end
    local adminls = admin:FindFirstChild("Admin LS")
    if not adminls then return end
    local template = adminls:FindFirstChild("ListItem") or adminls:FindFirstChild("CommandListItem")
    if not template then return end
    local list = admin:FindFirstChild(listname)
    if not list then return end

    for _, child in ipairs(admin:GetChildren()) do
        if child:IsA("ScrollingFrame") then child.Visible = false end
    end
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    local titlebar = admin:FindFirstChild("TitleBar")
    if titlebar and titlebar:FindFirstChild("Title") then
        titlebar.Title.Text = titletext
    end

    for i, item in ipairs(items) do
        local clone = template:Clone()
        clone.Name = "Item" .. i
        clone.Text = labelfactory(item)
        clone.LayoutOrder = i
        clone.Parent = list
    end

    list.Visible = true

    local layout = list:FindFirstChildOfClass("UIListLayout")
    if layout then
        list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
    end
end

local function openadminlist(listname, titletext, items, labelfactory)
    renderlist(listname, titletext, items, labelfactory)
    local gm, admin = getadmin()
    if not admin then return end
    gm.Enabled = true
    admin.Position = UDim2.new(0.5, 0, 1.5, 0)
    admin.Visible = true
    _G.InMenu = admin
    _G.InMenuType = "Small"
    tween:Create(
        admin,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.5, 0, 0.5, 0) }
    ):Play()
end

local function onlocalcommand(text)
    local cmd = parsecommand(text)
    if not cmd then return end

    if cmd == "killlogs" or cmd == "kl" then
        notify("Red", "sorry this doesnt work yet", 5)
    elseif cmd == "commands" or cmd == "cmds" then
        openadminlist("CommandsList", "Admin Commands", commands, function(c) return c end)
    elseif cmd == "logs" then
        local items = _G._adminLogsCache
        if #items == 0 then
            items = { { "no commands yet", "waiting for a command", os.time() } }
        end
        openadminlist("LogsList", "Admin Logs", items,
            function(e) return tostring(e[1]) .. " - " .. tostring(e[2]) end)
    end
end

local function handlemessage(text)
    if not enabled then return end
    onlocalcommand(text)
end

